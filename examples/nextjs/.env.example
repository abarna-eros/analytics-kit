# Copy to .env.local and fill in your own values.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle. Only public,
# client-safe identifiers belong here.
#
# These are public and client-safe:
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_SEGMENT_WRITE_KEY=YOUR_SEGMENT_WRITE_KEY
NEXT_PUBLIC_CLARITY_PROJECT_ID=YOUR_CLARITY_PROJECT_ID

# These must NEVER be prefixed with NEXT_PUBLIC_ and must never reach a client
# component. They belong in server-only code (route handlers, server actions):
#
# GA4_API_SECRET=...            (Measurement Protocol)
# SEGMENT_ACCESS_TOKEN=...      (Public API / server-side tracking)
# CLARITY_DATA_EXPORT_TOKEN=... (Data Export API)
