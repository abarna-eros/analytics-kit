# Copy to .env.local and fill in your own values.
#
# All three are PUBLIC client-side identifiers and are safe to expose in a
# browser bundle. Never put a GA4 Measurement Protocol API secret, a Segment
# access token or a Clarity Data Export token in a VITE_ variable.

VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_SEGMENT_WRITE_KEY=YOUR_SEGMENT_WRITE_KEY
VITE_CLARITY_PROJECT_ID=YOUR_CLARITY_PROJECT_ID
